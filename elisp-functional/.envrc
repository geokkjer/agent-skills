#!/usr/bin/env bash
# Direnv configuration for Elisp development.
# Drop this into any project that wants deterministc Emacs + tooling.
#
# Usage:
#   cp $(dirname $0)/.envrc /path/to/your/project/.envrc
#   cd /path/to/your/project
#   direnv allow
#
# Or symlink it if you want the source of truth in the skill directory:
#   ln -sf ~/.agents/skills/elisp-functional/.envrc /path/to/your/project/.envrc

use flake ~/.agents/skills/elisp-functional
